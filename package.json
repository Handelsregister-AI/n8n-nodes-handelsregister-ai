{
  "name": "@handelsregister/n8n-nodes-handelsregister-ai",
  "version": "0.5.0",
  "description": "n8n community node for Handelsregister.ai API integration",
  "keywords": [
    "n8n-community-node-package",
    "handelsregister",
    "german-business-registry",
    "company-data",
    "unternehmensregister"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Handelsregister-AI/n8n-nodes-handelsregister-ai",
  "author": {
    "name": "Handelsregister AI",
    "email": "team@handelsregister.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Handelsregister-AI/n8n-nodes-handelsregister-ai.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js && npm run lint",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials icons tests scripts .github/workflows README.md CHANGELOG.md package.json docker-compose.e2e.yml vitest.config.ts eslint.config.mjs tsconfig.json tsconfig.eslint.json --write",
    "format:check": "prettier nodes credentials icons tests scripts .github/workflows README.md CHANGELOG.md package.json docker-compose.e2e.yml vitest.config.ts eslint.config.mjs tsconfig.json tsconfig.eslint.json --check",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --omit=dev",
    "pack:e2e": "node scripts/prepare-e2e.js",
    "docker:e2e:up": "docker compose -f docker-compose.e2e.yml up --build --detach",
    "docker:e2e:down": "docker compose -f docker-compose.e2e.yml down --volumes --remove-orphans",
    "docker:e2e:test": "node scripts/run-docker-e2e.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/HandelsregisterAiApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/HandelsregisterAi/HandelsregisterAi.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.42.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "9.32.0",
    "n8n-workflow": "2.31.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {},
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "packageManager": "npm@11.11.0"
}
